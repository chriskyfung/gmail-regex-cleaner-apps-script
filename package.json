{
  "name": "gmail-regex-cleaner-apps-script",
  "version": "0.3.7",
  "private": true,
  "description": "A Google Apps Script that helps you delete Gmail messages older than n days that match your custom regex filters.",
  "scripts": {
    "build": "pnpm run clean && node scripts/build.mjs && pnpm run update-timezone",
    "clean": "rimraf dist",
    "update-timezone": "node scripts/update-timezone.mjs",
    "lint": "eslint src/**/*.js",
    "format": "prettier --write src/**/*.js",
    "login": "clasp login",
    "logout": "clasp logout",
    "pull": "clasp pull",
    "push": "clasp push",
    "push:watch": "clasp push -w",
    "status": "clasp status",
    "open": "clasp open",
    "deployments": "clasp deployments",
    "versions": "clasp versions",
    "logs": "clasp logs",
    "test": "jest",
    "validate": "pnpm run lint && pnpm test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chriskyfung/gmail-regex-cleaner-apps-script.git"
  },
  "keywords": [
    "google-apps-script",
    "gmail",
    "mail-filter",
    "mail-remove"
  ],
  "author": "Chris K.Y. FUNG (https://chriskyfung.github.io/)",
  "license": "AGPL-3.0",
  "bugs": {
    "url": "https://github.com/chriskyfung/gmail-regex-cleaner-apps-script/issues"
  },
  "homepage": "https://github.com/chriskyfung/gmail-regex-cleaner-apps-script#readme",
  "funding": [
    {
      "type": "github",
      "url": "https://github.com/sponsors/chriskyfung"
    },
    {
      "type": "buymeacoffee",
      "url": "https://www.buymeacoffee.com/chrisfungky"
    }
  ],
  "config": {
    "examples": {
      "exclude": []
    }
  },
  "engines": {
    "node": "^22.18.0 || >=24.11.0"
  },
  "type": "module",
  "devDependencies": {
    "@babel/core": "^8.0.10",
    "@babel/preset-env": "^8.0.7",
    "@eslint/js": "^10.0.1",
    "@google/clasp": "^3.4.1",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@types/google-apps-script": "^2.0.14",
    "@types/jest": "^30.0.0",
    "@types/sanitize-html": "^2.16.1",
    "babel-jest": "^30.5.2",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-googleappsscript": "^1.0.5",
    "eslint-plugin-jest": "^29.17.0",
    "eslint-plugin-prettier": "^5.5.7",
    "globals": "^17.13.0",
    "jest": "^30.5.2",
    "prettier": "^3.9.10",
    "rimraf": "^6.1.3",
    "rollup": "^4.65.1"
  },
  "dependencies": {
    "sanitize-html": "^2.18.1"
  },
  "packageManager": "pnpm@12.16.1+sha512.091d1dee7927575661b25dab3c2ae31cafc1c54d6b71ed6a6600cf0c1cb10434a447eae14015f1b23e2e6bedeed79df94a932e2164d2832280dce3fb32f656d1"
}
